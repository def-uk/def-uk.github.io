#!/bin/sh
# 커밋 전 검사(위반 시 커밋 중단):
#  1) ko/en 짝 동기화 — 한쪽만 스테이징되면 거부
#  2) 게시글 이미지 규칙 — 언어쌍 누락 / 언어 교차 참조 / 없는 이미지 참조 거부
#  3) ko/en 구조 drift — 링크·이미지·표·코드블록·frontmatter 불일치 (LLM 없이 무료)
# 설치: git config core.hooksPath .githooks
#
# 유료 LLM 의미 검사는 끄고 구조 검사만 돈다(docs/PLAN.md §6). 의미 검사를 켜려면
# 마지막 줄의 --structure-only 를 지운다. 전부 건너뛰려면 git commit --no-verify.
root="$(git rev-parse --show-toplevel)"
node "$root/scripts/check-bilingual.mjs" --staged || exit 1
node "$root/scripts/check-post-images.mjs" --staged || exit 1
node "$root/scripts/check-drift.mjs" --staged --structure-only || exit 1
